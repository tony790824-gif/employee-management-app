{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bankeban-production-0001-0008-application-owner-relation-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "sourceCommitSha",
    "objectSetVersion",
    "objectSetFingerprint",
    "ownershipCoverageCount",
    "expectedOwnershipCount",
    "ownerSetCount",
    "exactOwnerMatch",
    "reviewedCategory",
    "proofEnum",
    "ambiguity",
    "membershipClassification",
    "roleBoundaryResult",
    "grantOptionSemanticResult",
    "finalProofStatus",
    "blockers",
    "rawOidPersisted",
    "rawPrincipalNamePersisted",
    "businessRowsRead"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modelVersion": { "const": "bankeban-exact-application-owner-proof-v1" },
    "sourceCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "objectSetVersion": { "const": "bankeban-0001-0008-application-owner-set-v1" },
    "objectSetFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ownershipCoverageCount": { "type": "integer", "minimum": 0, "maximum": 65 },
    "expectedOwnershipCount": { "const": 65 },
    "ownerSetCount": { "type": "integer", "minimum": 0 },
    "exactOwnerMatch": { "type": "boolean" },
    "reviewedCategory": { "enum": ["EXPECTED_OWNER", "UNCLASSIFIED"] },
    "proofEnum": { "enum": ["EXACT_APPLICATION_OBJECT_OWNER_RELATION", "EXACT_APPLICATION_OBJECT_OWNER_RELATION_NOT_PROVEN"] },
    "ambiguity": { "type": "boolean" },
    "membershipClassification": { "enum": ["NONE", "UNEXPECTED_OUTBOUND"] },
    "roleBoundaryResult": { "enum": ["PASS", "BLOCKED"] },
    "grantOptionSemanticResult": { "enum": ["SEMANTIC_MISMATCH", "BLOCKED"] },
    "finalProofStatus": { "enum": ["PASS", "BLOCKED"] },
    "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rawOidPersisted": { "const": false },
    "rawPrincipalNamePersisted": { "const": false },
    "businessRowsRead": { "const": false }
  }
}

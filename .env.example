# Copy to a local untracked .env file or configure these in the hosting secret store.
BANK_ENV=local
# Required in Staging so a mislabeled environment cannot target another PostgreSQL project.
BANK_STAGING_DATABASE_HOST=staging.example.invalid
# Migration/import must use a direct endpoint and a schema-owner role.
DATABASE_MIGRATOR_URL=postgresql://banke_migrator:change-me@127.0.0.1:5432/banke?sslmode=verify-full
# Production evidence reads these only from the operator process environment, never from a committed or shared .env file.
# The role name is non-secret; the URL is a Secret and must remain blank here.
BANK_PRODUCTION_READONLY_ROLE=
DATABASE_READONLY_URL=
# Runtime API must use a separate least-privilege role; a pooler is allowed.
# Production must use the dedicated banke_api_production role and explicitly name /neondb.
DATABASE_API_URL=postgresql://banke_api:change-me@127.0.0.1:5432/banke?sslmode=verify-full
# Background Web Push worker must use a different least-privilege database role.
DATABASE_PUSH_URL=postgresql://banke_push:change-me@127.0.0.1:5432/banke?sslmode=verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_PUSH_POOL_MAX=2
# Authenticated in-process abuse protection. Keep upstream edge/WAF protection as a separate gate.
BANK_RATE_LIMIT_ENABLED=true
BANK_RATE_LIMIT_SESSION_PER_MINUTE=20
BANK_RATE_LIMIT_READ_PER_MINUTE=180
BANK_RATE_LIMIT_COMMAND_PER_MINUTE=60
# Non-sensitive immutable deployment identity. Render may use RENDER_GIT_COMMIT automatically.
BANK_BUILD_SHA=
# Public, non-secret origins used only by the explicit read-only Production platform validator.
# Leave blank until approved services exist; never use Draft, Staging, or Local URLs.
BANK_PRODUCTION_FRONTEND_URL=
BANK_PRODUCTION_API_URL=
# Production evidence collection identifiers are non-secret; access tokens below are secrets and must remain protected/untracked.
BANK_PRODUCTION_NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
BANK_PRODUCTION_NETLIFY_READONLY_CONFIRM=
BANK_PRODUCTION_RENDER_SERVICE_ID=
RENDER_API_KEY=
BANK_PRODUCTION_RENDER_READONLY_CONFIRM=
BANK_PRODUCTION_AUTH0_CLIENT_ID=
AUTH0_MANAGEMENT_TOKEN=
# Bounded Staging-only capacity probe. Keep any token in the ignored operator environment.
BANK_CAPACITY_TARGET_URL=https://staging.example.invalid
BANK_CAPACITY_STAGING_HOST=staging.example.invalid
BANK_CAPACITY_ROUTE=/v1/readiness
BANK_CAPACITY_REQUESTS=60
BANK_CAPACITY_CONCURRENCY=5
BANK_CAPACITY_P95_LIMIT_MS=750
BANK_CAPACITY_ACCESS_TOKEN=
BANK_CAPACITY_WORKSPACE_ID=
# Required only for the destructive, staging-only restore rehearsal.
BANK_STAGING_RESTORE_CONFIRM=
# Optional PostgreSQL client-tool directory (pg_dump and pg_restore).
POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
BANK_ALLOWED_ORIGINS=http://127.0.0.1:4173
# OIDC access-token verification. Use isolated Staging tenant identifiers here;
# these identifiers are not secrets, but they must never point at Production.
BANK_OIDC_ISSUER=https://staging-tenant.example.invalid/
BANK_OIDC_AUDIENCE=https://bankeban-staging-api
BANK_OIDC_JWKS_URL=https://staging-tenant.example.invalid/.well-known/jwks.json
BANK_OIDC_SESSION_CLAIM=https://banke.tw/session_id
# Generate a 32-byte value and encode it as base64url. Store the real key only
# in the environment/secret manager; rotate BANK_TENANT_CONTEXT_KEY_ID with it.
BANK_TENANT_CONTEXT_KEY=replace-with-32-byte-base64url-secret
BANK_TENANT_CONTEXT_KEY_ID=staging-context-key-1
# Keep loopback locally. An isolated Staging container may explicitly bind all
# interfaces; the API rejects every other bind-host value.
BANK_API_BIND_HOST=127.0.0.1
PORT=8080
# Standard Web Push. The private key is a Secret and must never enter a browser build.
BANK_WEB_PUSH_ENABLED=false
BANK_WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
BANK_WEB_PUSH_PRIVATE_KEY=replace-with-vapid-private-key
BANK_WEB_PUSH_SUBJECT=mailto:security@example.invalid
# Netlify Scheduled Function uses at most four deliveries per invocation so its
# worst-case provider timeouts remain inside the platform's 30-second limit.
BANK_WEB_PUSH_SCHEDULED_BATCH_SIZE=4
